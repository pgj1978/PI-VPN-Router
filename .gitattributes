# Normalise to LF in the repository.
* text=auto eol=lf

# These are executed on Linux. A CRLF line ending here produces
# "bad interpreter: /usr/bin/env bash^M" and the script simply will not run.
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.template text eol=lf

# Windows-only helpers stay CRLF.
*.ps1 text eol=crlf

# Binary
*.woff binary
*.woff2 binary
*.ico binary
*.png binary
