# PiRouter configuration - the single source of truth for network topology.
#
# Copy to .env and adjust. Nothing here is duplicated in code: the previous build had the
# LAN address hardcoded three separate ways (192.168.10.1 in DeviceManager.cs,
# 192.168.100.1 in setup_pi.sh, 192.168.10.1 again in the deploy scripts) and none of them
# matched the network it was actually running on.

# ---- interfaces
# LAN faces your devices, WAN faces the upstream internet router.
LAN_INTERFACE=eth1
WAN_INTERFACE=eth0
VPN_INTERFACE=wg0

# ---- addressing
# The Pi's own address on the LAN, with prefix. install.sh makes this persistent.
LAN_ADDRESS=192.168.20.1/24
# Host portion only, used by nginx to bind the UI to the LAN and nothing else.
LAN_IP=192.168.20.1

# ---- DHCP
DHCP_RANGE_START=192.168.20.10
DHCP_RANGE_END=192.168.20.200
DHCP_LEASE_TIME=12h

# ---- ports
UI_PORT=4200
API_PORT=51508

# ---- behaviour
# Set false to have the API compute and log firewall rules without applying them. Useful
# for inspecting exactly what a change would do before letting it touch a live router.
APPLY_RULES=true

# How often the reconciler re-checks and repairs firewall state, in seconds.
RECONCILE_INTERVAL=15
